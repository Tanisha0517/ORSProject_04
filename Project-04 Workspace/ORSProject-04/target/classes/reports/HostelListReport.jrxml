<?xml version="1.0" encoding="UTF-8"?>

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="HostelReport"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <property name="com.jaspersoft.studio.data.sql.tables" value=""/>
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="jdbcdata"/>

    <queryString language="SQL">
        <![CDATA[select * from st_hostel]]>
    </queryString>

    <field name="id" class="java.lang.Long"/>
    <field name="hostelName" class="java.lang.String"/>
    <field name="hostelType" class="java.lang.String"/>
    <field name="contactNo" class="java.lang.String"/>
    <field name="wardenName" class="java.lang.String"/>
    <field name="address" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="79" splitType="Stretch">
            <staticText>
                <reportElement x="220" y="25" width="150" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Hostel Report]]></text>
            </staticText>
        </band>
    </title>

    <pageHeader>
        <band height="10" splitType="Stretch"/>
    </pageHeader>

    <columnHeader>
        <band height="30" splitType="Stretch">

            <staticText>
                <reportElement x="0" y="0" width="65" height="30"/>
                <text><![CDATA[id]]></text>
            </staticText>

            <staticText>
                <reportElement x="65" y="0" width="100" height="30"/>
                <text><![CDATA[hostel_name]]></text>
            </staticText>

            <staticText>
                <reportElement x="165" y="0" width="90" height="30"/>
                <text><![CDATA[hostel_type]]></text>
            </staticText>

            <staticText>
                <reportElement x="255" y="0" width="85" height="30"/>
                <text><![CDATA[contact_no]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="0" width="100" height="30"/>
                <text><![CDATA[warden_name]]></text>
            </staticText>

            <staticText>
                <reportElement x="440" y="0" width="115" height="30"/>
                <text><![CDATA[address]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="30" splitType="Stretch">

            <textField>
                <reportElement x="0" y="0" width="65" height="30"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="65" y="0" width="100" height="30"/>
                <textFieldExpression><![CDATA[$F{hostelName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="165" y="0" width="90" height="30"/>
                <textFieldExpression><![CDATA[$F{hostelType}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="255" y="0" width="85" height="30"/>
                <textFieldExpression><![CDATA[$F{contactNo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="340" y="0" width="100" height="30"/>
                <textFieldExpression><![CDATA[$F{wardenName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="440" y="0" width="115" height="30"/>
                <textFieldExpression><![CDATA[$F{address}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <columnFooter>
        <band height="20" splitType="Stretch"/>
    </columnFooter>

    <pageFooter>
        <band height="30" splitType="Stretch"/>
    </pageFooter>

    <summary>
        <band height="20" splitType="Stretch"/>
    </summary>

</jasperReport>
